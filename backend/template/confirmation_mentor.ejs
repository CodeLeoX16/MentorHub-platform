<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Booking Received</title>
    <style>
      body { font-family: Arial, sans-serif; background-color: #f7f9fb; color: #333; margin: 0; padding: 0; }
      .container { max-width: 600px; margin: 20px auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden; }
      .header { background:#2b6cb0; color:#fff; padding:18px; text-align:center; font-size:20px; }
      .content { padding:20px; }
      .content h2 { margin-top:0; }
      .content p { line-height:1.6; }
      .btn { display:inline-block; margin-top:14px; padding:10px 16px; background:#2b6cb0; color:#fff; text-decoration:none; border-radius:4px; }
      .footer { background:#f0f4f8; padding:12px; text-align:center; color:#666; font-size:13px; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">New Booking Received</div>
      <div class="content">
        <h2>Hi <%= name %>,</h2>
        <p>
          You have a new booking for your service <strong><%= serviceName %></strong>.
        </p>
        <p>
          <strong>Student:</strong> <%= studentName %><br />
          <strong>Date:</strong> <%= date %><br />
          <strong>Time:</strong> <%= time %>
        </p>
        <p>
          Join the meeting with the student using the link below:
        </p>
        <p>
          <a class="btn" href="<%= meetingLink %>">Open Meeting Link</a>
        </p>
        <p>
          Please check your schedule and reach out to the student if you need to reschedule.
        </p>
      </div>
      <div class="footer">
        <p>If you have questions, reply to this email or contact support.</p>
      </div>
    </div>
  </body>
</html>
